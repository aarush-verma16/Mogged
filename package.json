{
  "name": "mogged",
  "private": true,
  "description": "Native macOS desktop app. npm scripts only wrap local build/run.",
  "scripts": {
    "start": "zsh scripts/run-mogged.sh",
    "dev": "zsh scripts/run-mogged.sh",
    "build": "swift build --package-path apps/launcher",
    "test": "zsh scripts/test.sh",
    "test:watch": "zsh scripts/test.sh --watch",
    "test:i": "zsh scripts/test.sh -i",
    "runtime": "swift run --package-path runtime mogged-runtime",
    "bootstrap": "zsh scripts/bootstrap-runtime.sh",
    "fetch": "zsh scripts/fetch-windows-title.sh"
  }
}
